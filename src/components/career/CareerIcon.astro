---
interface Props { name: string; }
const { name } = Astro.props;
import { careerIcons } from '../../data/career-icons';
---
<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={careerIcons[name] || careerIcons.medical} />
