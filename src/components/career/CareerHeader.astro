---
import { ROUTES } from '../../data/routes';
const isCareer = true;
const arrow = '<svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 14 14 4M6 4h8v8"/></svg>';
---
<header style="position: sticky; top: 0; z-index: 50; height: 84px; padding: 0 4vw; display: flex; align-items: center; justify-content: space-between; background: rgba(13,13,14,.82); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border-bottom: 1px solid #1E1E20;">
<a href={ROUTES.home} style="display: block;" aria-label="Ростех Техприёмка, на главную"><img src="/assets/logo_white.png" alt="Ростех Техприёмка" width="200" height="40" style="height: 40px; width: auto; display: block;"></a>
<nav aria-label="Основное меню" style="display: flex; align-items: center; gap: 40px;">
<a href={ROUTES.home} class="navlink">РТ-Техприёмка</a>
<a href={ROUTES.directions} class="navlink" aria-current={!isCareer ? 'page' : undefined} style={!isCareer ? "opacity: 1; box-shadow: inset 0 -1px 0 #F4F3EF; padding-bottom: 4px;" : undefined}>Решения</a>
<a href={ROUTES.career} class="navlink" aria-current={isCareer ? 'page' : undefined}>Карьера</a>
<a href="#" class="navlink">Пресс-центр</a>
<a href={isCareer ? '#resume' : '#contact'} class="hsq" aria-label={isCareer ? 'Оставить резюме' : 'Подобрать решение'} title={isCareer ? 'Оставить резюме' : 'Подобрать решение'} style="margin-left: -8px;" set:html={arrow} />
</nav>
</header>
