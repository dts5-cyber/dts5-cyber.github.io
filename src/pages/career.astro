---
import Base from '../layouts/CareerBase.astro';
import Header from '../components/career/CareerHeader.astro';
import Footer from '../components/career/CareerFooter.astro';
import { careerConfig, heroImages, directions, exampleVacancies, stories, steps, careBenefits } from '../data/career';
import CareerIcon from '../components/career/CareerIcon.astro';
import { vacancyIcon } from '../data/career-icons';
import '../styles/career.css';
import '../styles/career-motion.css';
const vacancies = careerConfig.demo ? exampleVacancies.slice(0, 3) : [];
---
<Base title="Карьера — РТ-Техприёмка" description="Инженерные профессии, цифровые технологии и работа в команде РТ-Техприёмки. Демонстрационный макет карьерного раздела." pageClass="page-career" ogImage="/assets/career/career-hero.webp">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <script slot="head" is:inline>if(!matchMedia('(prefers-reduced-motion: reduce)').matches){document.documentElement.classList.add('motion');setTimeout(function(){if(!window.__careerMotion)document.documentElement.classList.remove('motion')},3000)}</script>
  <Header />
  <main id="main">
    <section class="career-hero" aria-labelledby="career-title">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-content">
        <h1 id="career-title">Строй промышленность <span class="cu">будущего</span> <span class="hero-title-together">вместе с нами</span></h1>
        <a class="ctaA hero-cta" href="#vacancies">Смотреть вакансии <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-gallery" role="region" aria-label="Направления группы" tabindex="0">
        <div class="hero-gallery-track">
          {[false, true].map(duplicate => (
            <ul class="hero-gallery-group" role="list" aria-hidden={duplicate ? 'true' : undefined}>
              {heroImages.map((photo, index) => (
                <li class="hero-gallery-photo">
                  <img src={`/assets/career/${photo.image}.webp`} alt="" width="1200" height="900" loading={duplicate || index >= 4 ? 'lazy' : 'eager'} />
                  <span class="hero-gallery-label">{photo.label}</span>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
      <p class="hero-demo">Демонстрационные иллюстрации направлений группы</p>
    </section>

    <section class="career-section" id="career-directions" aria-labelledby="directions-title">
      <div class="section-heading directions-heading"><h2 class="h2" id="directions-title">Найди своё <span class="cu">направление</span></h2></div>
      <div class="direction-filters" role="tablist" aria-label="Направления карьеры">{directions.map((d, i) => <button type="button" class="direction-filter" id={`direction-tab-${i}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`direction-panel-${i}`} tabindex={i === 0 ? 0 : -1} data-direction-tab={i}>{d.label}</button>)}</div>
      <div class="direction-panels">{directions.map((d, i) => <div class="direction-panel" id={`direction-panel-${i}`} role="tabpanel" aria-labelledby={`direction-tab-${i}`} hidden={i !== 0} tabindex="0"><article class="direction-task-card"><div class="direction-card-meta"><span>{String(i+1).padStart(2,'0')} / {String(directions.length).padStart(2,'0')}</span><span>{d.title}</span></div><h3>{d.heading}</h3><p>{d.text}</p><ul>{d.tasks.map(task => <li>{task}</li>)}</ul><a class="ctaA" href="#resume" data-select-direction={d.title}>Мне интересно <span aria-hidden="true">↗</span></a></article><figure class="direction-image-card"><img src={`/assets/career/${d.image}.webp`} alt={`Демонстрационная иллюстрация: ${d.title}`} loading="lazy" width={d.width} height={d.height} style={`object-position:${d.position}`} /><figcaption>Демонстрационная иллюстрация</figcaption></figure></div>)}</div>
    </section>

    <section class="career-section opportunities" id="opportunities" aria-labelledby="opportunities-title">
      <div class="section-heading opportunities-heading"><h2 class="h2" id="opportunities-title">Участвуй в проектах <br /><span class="cu">федерального масштаба</span></h2></div>
      <div class="employer-grid">
        <article class="federal-card">
          <img src="/assets/career/federal-energy-complex.webp" alt="Иллюстрация энергокомплекса с линиями электропередачи и двумя инженерами" loading="lazy" width="1536" height="1024" />
        </article>
        <article class="growth-card">
          <h3>Профессиональное <br />развитие</h3>
          <ul>
            <li><span aria-hidden="true">↗</span>Программы обучения</li>
            <li><span aria-hidden="true">↗</span>Карьерный рост</li>
            <li><span aria-hidden="true">↗</span>Работа с ведущими экспертами промышленности</li>
            <li><span aria-hidden="true">↗</span>Освоение новых технологий на практике</li>
            <li><span aria-hidden="true">↗</span>Обмен опытом между командами</li>
          </ul>
          <p class="fine-print">Конкретные программы и условия развития уточняются у HR.</p>
        </article>
      </div>
      <div class="employee-care" aria-labelledby="employee-care-title">
        <div class="care-heading"><h3 id="employee-care-title">Забота о том, <span class="cu">что важно</span></h3><p>ДМС подтверждено. Дополнительные программы представлены для согласования с HR.</p></div>
        <div class="benefit-grid">
          {careBenefits.map(benefit => (
            <article class="benefit-card">
              {benefit.confirmed && (
                <div class="benefit-info">
                  <button
                    type="button"
                    class="benefit-info-button"
                    aria-label="Условия ДМС"
                    aria-expanded="false"
                    aria-controls={`benefit-note-${benefit.icon}`}
                  ><span aria-hidden="true">i</span></button>
                  <span class="benefit-info-note" id={`benefit-note-${benefit.icon}`} hidden>{benefit.note}</span>
                </div>
              )}
              <img
                class="benefit-icon"
                src={`/assets/career/benefit-${benefit.icon}-isometric.webp`}
                alt=""
                width="360"
                height="360"
                loading="lazy"
              />
              <h4>{benefit.title}</h4>
            </article>
          ))}
        </div>
        <p class="fine-print benefits-note">Дополнительные программы требуют подтверждения и не являются гарантированными условиями трудоустройства.</p>
      </div>
      <div class="rating"><div class="rating-score">4,5 <span>/ 5</span></div><div><span class="stars" aria-label="4,5 из 5 звёзд">★★★★<span>★</span></span><p>Оценка работодателя на hh.ru</p></div><small>Рейтинг из задания для макета.<br />Актуальность и ссылка на отзывы требуют проверки.</small><a href={careerConfig.employerUrl} target="_blank" rel="noopener noreferrer">Компания на hh.ru ↗</a></div>
    </section>

    <section class="career-section vacancy-section" id="vacancies" aria-labelledby="vacancies-title" data-demo={String(careerConfig.demo)} data-endpoint={careerConfig.vacanciesEndpoint}>
      <div class="section-heading vacancies-heading"><h2 class="h2" id="vacancies-title">Открытые вакансии</h2><p class="section-note" id="vacancy-notice">{careerConfig.demo ? 'Три вакансии компании с hh.ru.' : 'Актуальные позиции доступны на странице работодателя на hh.ru.'}</p></div>
      <div class="vacancy-grid">
        <div id="vacancy-list">
          {vacancies.map(v => (
            <article class="vacancy-card">
              <div class="vacancy-card-top"><span class="vacancy-icon"><CareerIcon name={vacancyIcon(v.direction)} /></span></div>
              <div class="vacancy-description"><h3>{v.title}</h3><p>{v.direction}</p></div>
              <div class="vacancy-meta"><span>{v.city}</span>{v.format && <span>{v.format}</span>}</div>
              <a class="vacancy-more" href={v.url} target="_blank" rel="noopener noreferrer" aria-label={`Подробнее о вакансии «${v.title}» на hh.ru`}>Подробнее <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
        <a class="vacancy-all-card" href={careerConfig.employerUrl} target="_blank" rel="noopener noreferrer"><span class="vacancy-icon"><CareerIcon name="jobs" /></span><h3>Все вакансии<br />на hh.ru</h3><span class="vacancy-all-action">Перейти на hh.ru <span aria-hidden="true">↗</span></span></a>
      </div>
      <p id="vacancy-empty" hidden={vacancies.length > 0}>Сейчас на сайте нет доступных вакансий. Посмотри предложения на странице работодателя.</p>
      <p class="fine-print vacancy-source-note">Проверяй условия и доступность позиции на hh.ru.</p>
    </section>

    <section class="career-section people-section" id="people" aria-labelledby="people-title">
      <div class="section-heading people-heading">
        <h2 class="h2" id="people-title">За каждым большим<br /> проектом <span class="cu">стоят люди</span></h2>
        <p class="section-note">Имена и истории вымышлены. Портреты созданы с помощью ИИ.</p>
      </div>
      <div class="stories">
        {stories.map((story, index) => (
          <article class="story">
            <div class="story-photo">
              <img src={`/assets/career/${story.image}.webp`} alt="" loading="lazy" width="800" height="1000" />
            </div>
            <div class="story-copy">
              <div class="story-author"><span>{story.name}</span><span>{story.role}</span></div>
              <h3>{story.title}</h3>
              <p>{story.summary}</p>
              <button type="button" class="text-action" data-story={index} aria-haspopup="dialog" aria-controls="career-dialog" aria-label={`Читать историю «${story.title}»`}>
                Читать историю <span aria-hidden="true">↗</span>
              </button>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="career-section hiring-section" id="hiring" aria-labelledby="hiring-title"><h2 class="h2" id="hiring-title">От знакомства<br /> до первого рабочего дня</h2><ol class="hiring-steps">{steps.map(([title,text],i)=><li><span class="step-number" aria-hidden="true">0{i+1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol><p class="fine-print">Предварительные этапы. Точный порядок трудоустройства необходимо согласовать с HR.</p></section>

    <section class="career-section resume-section" id="resume" aria-labelledby="resume-title"><div class="resume-intro"><h2 class="h2" id="resume-title">Не нашёл <br />подходящую<br /><span class="cu">вакансию?</span></h2><p>Оставь резюме и расскажи, в каком направлении хотел бы работать. Если появится подходящая позиция, мы сможем рассмотреть твою кандидатуру.</p><img src="/assets/career/career-cta-daylight.webp" alt="Инженеры за работой в производственном цехе" loading="lazy" width="1664" height="936" /><small>Демонстрационная иллюстрация</small></div>
      <div class="resume-form-wrap"><span class="demo-label">Демонстрационная форма</span><p class="fine-print">Можно проверить заполнение. Отправка резюме не подключена, данные останутся в браузере до закрытия страницы.</p>
      <form id="career-resume" novalidate data-endpoint={careerConfig.resumeEndpoint}>
        <div class="resume-fields"><div class="fld full"><label class="fld-l" for="resume-name">Имя и фамилия *</label><input class="inp" id="resume-name" name="name" autocomplete="name" required minlength="3" placeholder="Как к тебе обращаться" aria-describedby="error-name" /><span class="err" id="error-name"></span></div><div class="fld"><label class="fld-l" for="resume-phone">Телефон *</label><input class="inp" id="resume-phone" name="phone" type="tel" autocomplete="tel" required placeholder="+7 (___) ___-__-__" aria-describedby="error-phone" /><span class="err" id="error-phone"></span></div><div class="fld"><label class="fld-l" for="resume-email">Электронная почта *</label><input class="inp" id="resume-email" name="email" type="email" autocomplete="email" required placeholder="name@example.ru" aria-describedby="error-email" /><span class="err" id="error-email"></span></div><div class="fld full"><label class="fld-l" for="resume-direction">Интересующее направление *</label><select class="inp" id="resume-direction" name="direction" required aria-describedby="error-direction"><option value="">Выбери направление</option>{directions.map(d=><option>{d.title}</option>)}</select><span class="err" id="error-direction"></span></div><div class="fld full"><label class="upload" for="resume-file"><span aria-hidden="true">↥</span><span>Прикрепить резюме<small id="resume-filename">PDF, DOC или DOCX · до 10 МБ</small></span><input id="resume-file" name="resume" type="file" accept=".pdf,.doc,.docx" required aria-describedby="error-resume" /></label><span class="err" id="error-resume"></span></div></div>
        <label class="resume-consent"><input name="consent" type="checkbox" required aria-describedby="error-consent" /><span>Согласен на обработку персональных данных. <button type="button" class="legal-link" data-legal>Текст согласия и политика обработки данных</button></span></label><span class="err" id="error-consent"></span><p class="fine-print legal-note">Тексты и ссылки на юридические документы добавляются после согласования. В макете согласие не используется для обработки данных.</p><button type="submit" class="btnF">Отправить резюме <span aria-hidden="true">↗</span></button><p id="resume-status" role="status" aria-live="polite"></p>
      </form></div>
    </section>
  </main>
  <Footer />
  <dialog id="career-dialog" aria-labelledby="career-dialog-title">
    <button type="button" class="dialog-close" aria-label="Закрыть">×</button>
    <span class="demo-label" id="career-dialog-label">Материалы для согласования</span>
    <h2 id="career-dialog-title"></h2>
    <p class="dialog-byline" id="career-dialog-byline" hidden></p>
    <div id="career-dialog-text"></div>
  </dialog>
  <script>import '../scripts/career';</script>
  <script>import '../scripts/career-motion';</script>
</Base>
